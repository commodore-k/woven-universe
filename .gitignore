# Ignore everything in .obsidian by default
.obsidian/*

# Allow tracking for core configurations
!.obsidian/app.json
!.obsidian/appearance.json
!.obsidian/core-plugins.json
!.obsidian/community-plugins.json
!.obsidian/snippets/

# Always ignore volatile UI state and caches
.obsidian/workspace
.obsidian/workspace.json
.obsidian/cache
.obsidian/plugins/*/data.json
